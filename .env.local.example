# Copy this file to `.env.local` for local development.
# Never commit real keys. `.env` and `.env*.local` are gitignored.

# Required only when a user taps Ask Gemini in the chat bubble (opt-in, 1× per title).
# Search / browse NEVER use Gemini — only Shikimori.
# Create a key at https://aistudio.google.com/apikey
# Also set this in Vercel → Project → Settings → Environment Variables.
GEMINI_API_KEY=

# Optional. Defaults try gemini-3.1-flash-lite then gemini-2.0-flash.
# GEMINI_MODEL=gemini-3.1-flash-lite
