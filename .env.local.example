# Copy this file to `.env.local` for local development.
# Never commit real keys. `.env` and `.env*.local` are gitignored.

# --- AniList ---
# Catalog reads use https://graphql.anilist.co with no API key.
# No ANILIST_* env vars are needed for this app.

# --- Gemini (optional) ---
# Required only when a user taps Ask Gemini in the detail-page chat (opt-in, 1× per title).
# Search / browse / free catalog picks NEVER use Gemini — only AniList.
# Create a key at https://aistudio.google.com/apikey
# Set the same variable in Vercel → Project → Settings → Environment Variables.
# Must stay server-side (no NEXT_PUBLIC_ prefix).
GEMINI_API_KEY=

# Optional. Defaults try gemini-3.1-flash-lite then gemini-2.0-flash.
# GEMINI_MODEL=gemini-3.1-flash-lite
