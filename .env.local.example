# Copy this file to `.env.local` for local development.
# Never commit real keys. `.env` and `.env*.local` are gitignored.

# Required for Gemini-powered recommendations on anime detail pages.
# Create a key at https://aistudio.google.com/apikey then paste it after the equals sign.
GEMINI_API_KEY=

# Optional model override (defaults to gemini-2.0-flash in code)
# GEMINI_MODEL=gemini-2.0-flash
